APP_NAME=SGCM-CMAS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sgcm_cmas
DB_USERNAME=cmas
DB_PASSWORD=change-me
DB_SSLMODE=prefer

# Redis / colas / cache / sesiones
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Tokens de acceso
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Culqi (NUNCA en el repo; el frontend usa pk_)
CULQI_API_KEY=sk_test_...
CULQI_API_BASE=https://api.culqi.com/v2
CULQI_WEBHOOK_SECRET=whsec_...

# RENIEC (consulta de DNI)
RENIEC_API_URL=https://api.reniec.gob.pe/...
RENIEC_API_TOKEN=...

# Email / SMS
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="cmas@localhost"
MAIL_FROM_NAME="${APP_NAME}"
SMS_API_KEY=...

# Storage (PDFs) — S3 compatible (R2, MinIO, AWS)
S3_ENDPOINT=https://
S3_BUCKET=sgcm-cmas-docs
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Reverb (WebSockets) — valores dev
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_APP_ID=local-app
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_APP_PORT=8080

# Cifrado de datos sensibles (AES-256, 32 bytes hex) — generar: bin2hex(random_bytes(32))
DATA_ENC_KEY=

VITE_APP_NAME="${APP_NAME}"